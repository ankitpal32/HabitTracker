# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority

# JWT Secret for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Port for local backend server
PORT=3000

# (Optional) Frontend URL for CORS if frontend is deployed on a different domain
# FRONTEND_URL=https://your-frontend.vercel.app
